{
  "name": "thermi_thermalprinteros",
  "version": "1.3.0",
  "type": "module",
  "description": "Thermi - Your Thermal Printer OS. Universal Thermal Printer OS & Studio for Bluetooth Pocket & POS Printers (58mm/80mm).",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "electron:start": "cross-env NODE_ENV=production electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:mac": "npm run build && electron-builder --mac",
    "electron:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.thermalprint.studio",
    "productName": "Thermal Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.6.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.68.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/html2canvas": "^0.5.35",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
